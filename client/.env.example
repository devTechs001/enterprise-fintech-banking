# Client environment variables. Copy to .env (or .env.mock for the preview).

# API configuration
# Use a RELATIVE path in every deployed environment: the browser cannot reach
# "localhost:3000" when the app is served through a proxy or preview host.
VITE_API_BASE_URL=/api/v1
VITE_API_VERSION=v1

# Serve the UI from the in-memory mock API instead of the Node backend.
# Development/preview only — must be false or unset in production.
VITE_USE_MOCK_API=false

# Only needed when VITE_USE_MOCK_API=false and the API is on another origin.
# VITE_API_PROXY_TARGET=http://127.0.0.1:3000

# Hostnames the dev server should accept (comma separated). `true` accepts any.
# VITE_ALLOWED_HOSTS=true

# Feature flags
VITE_ENABLE_MFA=true
VITE_ENABLE_NOTIFICATIONS=true

# Analytics / error reporting (leave blank to disable)
VITE_GOOGLE_ANALYTICS_ID=
VITE_SENTRY_DSN=

# Misc
VITE_APP_NAME=SecureBank
VITE_APP_VERSION=1.0.0

# NOTE: the previous file exposed VITE_JWT_EXPIRY / VITE_REFRESH_TOKEN_EXPIRY.
# Token lifetimes are a server-side decision; publishing them to the bundle gave
# the client no useful behaviour and leaked policy details.
