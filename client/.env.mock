# Preview configuration: run the React client against the in-memory mock API
# (client/mock/mockApiPlugin.js) with no database and no Node server.
#
#   npm run dev:mock
#
# Do NOT enable this in a production build.

VITE_USE_MOCK_API=true
VITE_API_BASE_URL=/api/v1
VITE_APP_NAME=SecureBank
VITE_APP_VERSION=1.0.0
