# Server environment variables.
#
# This file lists EXACTLY the variables server/src/config/index.js reads. Earlier
# revisions documented SendGrid, Twilio, Stripe, Plaid and S3 settings; those
# packages were audited out as declared-but-unused and the code no longer reads any
# of them, so listing them here only invited misconfiguration.
#
# Copy to .env and edit. Never commit .env.

# ---------------------------------------------------------------- core --------
NODE_ENV=development
PORT=3000
HOST=0.0.0.0
# Base URL of the deployed client. Used to build email links; NEVER derived from
# the request Host header, which an attacker controls.
PUBLIC_APP_URL=http://localhost:5173
LOG_LEVEL=info
LOG_FORMAT=json

# ------------------------------------------------------------- database -------
# Either DATABASE_URL, or the DB_* parts below it.
# DATABASE_URL=postgresql://user:password@host:5432/securebank
DB_HOST=localhost
DB_PORT=5432
DB_NAME=securebank
DB_USER=postgres
DB_PASSWORD=change-me
DB_POOL_MAX=10
DB_POOL_MIN=0
DB_POOL_IDLE=10000
DB_POOL_ACQUIRE=60000
# Allow Sequelize `alter` synchronisation. Default false. Setting it true in
# production throws at startup: schema changes belong in migrations (DEV-7).
DB_SYNC_ALTER=false

# ----------------------------------------------------------------- redis ------
# The server degrades gracefully with Redis off (no token blacklist cache).
REDIS_ENABLED=true
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# ------------------------------------------------------------------ jwt -------
# REQUIRED in production, minimum 32 characters, or the server refuses to start.
# The previous config silently fell back to literal secrets published in this
# repository; that fail-fast is deliberate. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRATION_MINUTES=15
JWT_REFRESH_EXPIRATION_DAYS=7
JWT_ISSUER=securebank
JWT_AUDIENCE=securebank-clients

# ------------------------------------------------- secrets at rest ------------
# AES-256-GCM key for card numbers and MFA secrets. 32 bytes, base64:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
FIELD_ENCRYPTION_KEY=

# ------------------------------------------------------- security policy ------
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_DURATION_MINUTES=15
MAX_MFA_ATTEMPTS=5
MFA_TEMP_TOKEN_TTL_SECONDS=300
PASSWORD_MIN_LENGTH=12
BCRYPT_ROUNDS=12
REQUIRE_EMAIL_VERIFICATION=true
RESET_TOKEN_TTL_MINUTES=30
VERIFICATION_TOKEN_TTL_HOURS=24
MAX_SESSIONS_PER_USER=5
SESSION_MAX_AGE_DAYS=7

# Rate limits: global, auth (successful requests skip the count), sensitive.
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=10
AUTH_RATE_LIMIT_WINDOW_MS=900000
SENSITIVE_RATE_LIMIT_MAX=5

# ---------------------------------------------------- cookies / cors / csp ----
# Comma-separated allow-list. Not a wildcard.
CORS_ORIGIN=http://localhost:5173
CSP_ENABLED=true
HSTS_MAX_AGE=31536000
# Set true only when you terminate TLS in front of the app and need secure cookies
# on a non-HTTPS internal hop.
FORCE_SECURE_COOKIES=false
COOKIE_DOMAIN=
# Hops between the edge and this process, so rate limits see real client IPs.
TRUST_PROXY_HOPS=1

# ----------------------------------------------------------------- email ------
# There is no real mail transport yet (DEV-8). With the default provider the
# notification service returns { delivered: false, reason } instead of pretending.
EMAIL_PROVIDER=log
EMAIL_FROM=noreply@securebank.test
